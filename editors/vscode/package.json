{
  "name": "oii",
  "displayName": "OII",
  "description": "OII, the config language for Xyle. Brackets for scope.",
  "version": "1.0.0",
  "publisher": "celvra",
  "license": "Apache-2.0",
  "icon": "icon.svg",
  "homepage": "https://github.com/xyle-os/oii",
  "repository": {
    "type": "git",
    "url": "https://github.com/xyle-os/oii.git"
  },
  "bugs": {
    "url": "https://github.com/xyle-os/oii/issues"
  },
  "keywords": ["oii", "config", "brackets", "grammar"],
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "oii",
        "aliases": ["OII", "oii"],
        "extensions": [".oii"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oii",
        "scopeName": "source.oii",
        "path": "./syntaxes/oii.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "oii",
        "path": "./snippets/oii.json"
      }
    ]
  }
}
