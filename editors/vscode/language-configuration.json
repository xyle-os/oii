{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [["[", "]"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "/*", "close": " */" }
  ],
  "surroundingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "#\"", "close": "\"#" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\[[^\\]]*$",
    "decreaseIndentPattern": "^\\s*\\]"
  },
  "wordPattern": "[A-Za-z_\\u0080-\\uFFFF][\\w.\\-\\+]*",
  "onEnterRules": [
    {
      "beforeText": "^\\s*[^\\[\\]]*\\[\\s*(//.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*\\].*$",
      "action": { "indent": "outdent" }
    }
  ]
}
